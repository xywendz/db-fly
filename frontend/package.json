{
  "name": "db-fly-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode gui",
    "dev:web": "vite --mode web",
    "build": "vite build --mode gui",
    "build:gui": "vite build --mode gui",
    "build:web": "vite build --mode web",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --mode gui",
    "preview:web": "vite preview --mode web",
    "generate:bindings": "wails3 generate bindings -names -i -d ./src/bindings ./internal/bridge"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
